      {
       "id": "L1-3-03",
       "speaker": "tom",
       "en": "Thank you!",
       "zh": "谢谢！",
       "audio": "L1-3-03.mp3",
       "image": "L1-3-03.jpg"
      },
      {
       "id": "L1-3-04",
       "speaker": "mom",
       "en": "You're welcome.",
       "zh": "不客气。",
       "audio": "L1-3-04.mp3",
       "image": "L1-3-04.jpg"
      },
      {
       "id": "L1-3-05",
       "speaker": "tom",
       "en": "Sorry!",
       "zh": "对不起！",
       "audio": "L1-3-05.mp3",
       "image": "L1-3-05.jpg"
