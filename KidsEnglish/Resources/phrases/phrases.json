      },
      {
       "id": "L1-6-07",
       "speaker": "tom",
       "en": "I love you, too.",
       "zh": "我也爱你。",
       "audio": "L1-6-07.mp3",
       "image": "L1-6-07.jpg"
      }
     ]
    }
