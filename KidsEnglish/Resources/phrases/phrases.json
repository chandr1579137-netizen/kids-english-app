     "titleZh": "晚上好·晚安",
     "titleEn": "Good Night!",
     "lines": [
      {
       "id": "L1-6-01",
       "speaker": "tom",
       "en": "Good evening, Dad!",
       "zh": "晚上好，爸爸！",
       "audio": "L1-6-01.mp3",
       "code": "evening",
       "codeIcon": "house"
      },
      {
