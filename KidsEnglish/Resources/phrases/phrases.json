       "audio": "L2-5-01.mp3",
       "code": "mood",
       "codeIcons": [
        "laugh",
        "tired",
        "angry"
       ]
      },
      {
       "id": "L2-5-02",
       "speaker": "tom",
       "en": "I'm happy!",
       "zh": "我很开心！",
       "audio": "L2-5-02.mp3",
       "icon": "happy"
      },
      {
       "id": "L2-5-03",
       "speaker": "mom",
       "en": "Are you OK?",
       "zh": "你还好吗？",
       "audio": "L2-5-03.mp3",
       "icon": "kind"
      },
      {
       "id": "L2-5-04",
