   "titleZh": "我是谁·这是什么",
   "scenes": [
    {
     "id": "L2-1",
     "titleZh": "认识新朋友",
     "titleEn": "Nice to Meet You",
     "lines": [
      {
       "id": "L2-1-01",
       "speaker": "amy",
       "en": "What's your name?",
       "zh": "你叫什么名字？",
       "audio": "L2-1-01.mp3",
       "image": "L2-1-01.jpg"
      },
      {
       "id": "L2-1-02",
       "speaker": "tom",
       "en": "I'm Tom.",
       "zh": "我是汤姆。",
       "audio": "L2-1-02.mp3",
       "image": "L2-1-02.jpg"
      },
      {
       "id": "L2-1-03",
       "speaker": "tom",
       "en": "May I have your name?",
       "zh": "可以告诉我你的名字吗？",
       "audio": "L2-1-03.mp3",
       "image": "L2-1-03.jpg"
      },
      {
       "id": "L2-1-04",
       "speaker": "amy",
       "en": "My name is Amy.",
       "zh": "我叫艾米。",
       "audio": "L2-1-04.mp3",
       "image": "L2-1-04.jpg"
      },
      {
       "id": "L2-1-05",
       "speaker": "amy",
       "en": "Nice to meet you.",
       "zh": "很高兴认识你。",
       "audio": "L2-1-05.mp3",
       "image": "L2-1-05.jpg"
      },
      {
       "id": "L2-1-06",
       "speaker": "tom",
       "en": "Nice to meet you, too.",
       "zh": "我也很高兴认识你。",
       "audio": "L2-1-06.mp3",
       "image": "L2-1-06.jpg"
      },
      {
       "id": "L2-1-07",
       "speaker": "amy",
       "en": "How old are you?",
       "zh": "你几岁啦？",
       "audio": "L2-1-07.mp3",
       "image": "L2-1-07.jpg"
      },
      {
       "id": "L2-1-08",
       "speaker": "tom",
       "en": "I'm five.",
       "zh": "我五岁。",
       "audio": "L2-1-08.mp3",
       "code": "candles"
      }
     ]
    },
    {
     "id": "L2-2",
     "titleZh": "猜猜我是谁",
     "titleEn": "Who Are You?",
     "lines": [
      {
       "id": "L2-2-01",
       "speaker": "amy",
