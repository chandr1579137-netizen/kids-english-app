       "speaker": "tom",
       "en": "See you tomorrow!",
       "zh": "明天见！",
       "audio": "L1-5-06.mp3",
       "code": "tomorrow",
       "codeIcon": "school"
      },
      {
       "id": "L1-5-07",
       "speaker": "amy",
       "en": "See you later!",
       "zh": "待会儿见！",
       "audio": "L1-5-07.mp3",
       "image": "L1-5-07.jpg"
      }
     ]
    },
    {
