      {
       "id": "L2-2-02",
       "speaker": "tom",
       "en": "I'm a lion!",
       "zh": "我是狮子！",
       "audio": "L2-2-02.mp3",
       "icon": "lion"
      },
      {
       "id": "L2-2-03",
       "speaker": "amy",
       "en": "Are you Tom?",
       "zh": "你是汤姆吗？",
       "audio": "L2-2-03.mp3",
       "image": "L2-2-03.jpg"
      },
      {
       "id": "L2-2-04",
       "speaker": "tom",
       "en": "Yes, I am!",
       "zh": "是的，我是！",
       "audio": "L2-2-04.mp3",
       "code": "yes",
       "codeIcon": "boy"
      },
      {
       "id": "L2-2-05",
       "speaker": "tom",
       "en": "Are you a cat?",
       "zh": "你是小猫吗？",
       "audio": "L2-2-05.mp3",
       "image": "L2-2-05.jpg"
      },
      {
       "id": "L2-2-06",
       "speaker": "amy",
       "en": "No, I'm not.",
       "zh": "不，我不是。",
       "audio": "L2-2-06.mp3",
       "code": "no",
       "codeIcon": "cat"
      },
      {
       "id": "L2-2-07",
       "speaker": "amy",
       "en": "I'm a rabbit!",
       "zh": "我是小兔子！",
       "audio": "L2-2-07.mp3",
       "icon": "rabbit"
      }
     ]
    },
    {
     "id": "L2-3",
     "titleZh": "这是什么",
     "titleEn": "What's This?",
     "lines": [
      {
       "id": "L2-3-01",
       "speaker": "amy",
       "en": "What's this?",
       "zh": "这是什么？",
       "audio": "L2-3-01.mp3",
       "image": "L2-3-01.jpg"
      },
      {
