:"/assets/stories/l2/boss.webp","audioFile":"/assets/audio/l2/boss.mp3","nodeType":"boss","content":[{"paragraphId":"p1","text":"At the heart of Echo Valley lives a magical spirit. She can hear every sound in the valley.","translation":"在回声山谷的中心住着一个神奇的精灵。她能听到山谷里的每一个声音。","audioStart":0,"audioEnd":6504,"words":[{"word":"At","start":100,"end":287,"index":0},{"word":"the","start":300,"end":387,"index":1},{"word":"heart","start":400,"end":637,"index":2},{"word":"of","start":650,"end":737,"index":3},{"word":"Echo","start":750,"end":1037,"index":4},{"word":"Valley","start":1050,"end":1400,"index":5},{"word":"lives","start":1412,"end":1675,"index":6},{"word":"a","start":1687,"end":1737,"index":7},{"word":"magical","start":1750,"end":2250,"index":8},{"word":"spirit","start":2262,"end":2850,"index":9},{"word":"She","start":3712,"end":3950,"index":10},{"word":"can","start":3962,"end":4087,"index":11},{"word":"hear","start":4100,"end":4375,"index":12},{"word":"every","start":4387,"end":4637,"index":13},{"word":"sound","start":4650,"end":4987,"index":14},{"word":"in","start":5000,"end":5062,"index":15},{"word":"the","start":5075,"end":5150,"index":16},{"word":"valley","start":5162,"end":5625,"index":17}]},{"paragraphId":"p2","text":"The Echo Spirit has long silver hair and glowing blue eyes. Her voice is soft and gentle.","translation":"回声精灵有一头长长的银发和发光的蓝眼睛。她的声音柔和而温柔。","audioStart":0,"audioEnd":6960,"words":[{"word":"The","start":100,"end":275,"index":0},{"word":"Echo","start":287,"end":612,"index":1},{"word":"Spirit","start":625,"end":1025,"index":2},{"word":"has","start":1037,"end":1250,"index":3},{"word":"long","start":1262,"end":1562,"index":4},{"word":"silver","start":1575,"end":1950,"index":5},{"word":"hair","start":1962,"end":2300,"index":6},{"word":"and","start":2312,"end":2400,"index":7},{"word":"glowing","start":2412,"end":2800,"index":8},{"word":"blue","start":2812,"end":3050,"index":9},{"word":"eyes","start":3062,"end":3537,"index":10},{"word":"Her","start":4400,"end":4600,"index":11},{"word":"voice","start":4612,"end":4950,"index":12},{"word":"is","start":4962,"end":5087,"index":13},{"word":"soft","start":5100,"end":5462,"index":14},{"word":"and","start":5475,"end":5575,"index":15},{"word":"gentle","start":5587,"end":6075,"index":16}]},{"paragraphId":"p3","text":"\"Hello, young traveler,\" she says. \"I have been watching your journey through the valley.\"","translation":"\"你好，年轻的旅行者，\"她说。\"我一直看着你走过这座山谷。\"","audioStart":0,"audioEnd":6120,"words":[{"word":"Hello","start":100,"end":562,"index":0},{"word":"young","start":750,"end":962,"index":1},{"word":"traveler","start":975,"end":1475,"index":2},{"word":"she","start":1587,"end":1737,"index":3},{"word":"says","start":1750,"end":2237,"index":4},{"word":"I","start":3100,"end":3250,"index":5},{"word":"have","start":3262,"end":3400,"index":6},{"word":"been","start":3412,"end":3575,"index":7},{"word":"watching","start":3587,"end":3975,"index":8},{"word":"your","start":3987,"end":4112,"index":9},{"word":"journey","start":4125,"end":4462,"index":10},{"word":"through","start":4475,"end":4637,"index":11},{"word":"the","start":4650,"end":4750,"index":12},{"word":"valley","start":4762,"end":5237,"index":13}]},{"paragraphId":"p4","text":"\"You have learned many new words and helped many friends. You are ready for the next adventure.\"","translation":"\"你学会了很多新单词，帮助了很多朋友。你已经准备好迎接下一次冒险了。\"","audioStart":0,"audioEnd":6504,"words":[{"word":"You","start":100,"end":275,"index":0},{"word":"have","start":287,"end":425,"index":1},{"word":"learned","start":437,"end":750,"index":2},{"word":"many","start":762,"end":1012,"index":3},{"word":"new","start":1025,"end":1212,"index":4},{"word":"words","start":1225,"end":1612,"index":5},{"word":"and","start":1625,"end":1775,"index":6},{"word":"helped","start":1787,"end":2062,"index":7},{"word":"many","start":2075,"end":2325,"index":8},{"word":"friends","start":2337,"end":2937,"index":9},{"word":"You","start":3800,"end":3975,"index":10},{"word":"are","start":398