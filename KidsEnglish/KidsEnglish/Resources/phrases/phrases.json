       "speaker": "mom",
       "en": "Wash your hands.",
       "zh": "去洗手。",
       "audio": "L1-4-01.mp3",
       "icon": "wash"
      },
      {
       "id": "L1-4-02",
       "speaker": "tom",
       "en": "I'm hungry!",
       "zh": "我饿了！",
       "audio": "L1-4-02.mp3",
       "icon": "hungry"
      },
      {
