      {
       "id": "L1-4-05",
       "speaker": "tom",
       "en": "More rice, please.",
       "zh": "请再给我一点米饭。",
       "audio": "L1-4-05.mp3",
       "image": "L1-4-05.jpg"
      },
      {
       "id": "L1-4-06",
       "speaker": "tom",
       "en": "I'm thirsty.",
       "zh": "我渴了。",
       "audio": "L1-4-06.mp3",
       "icon": "thirsty"
      },
      {
       "id": "L1-4-07",
       "speaker": "tom",
       "en": "I'm full.",
       "zh": "我吃饱了。",
       "audio": "L1-4-07.mp3",
       "image": "L1-4-07.jpg"
      }
     ]
    },
    {
     "id": "L1-5",
     "titleZh": "说再见",
     "titleEn": "Goodbye!",
     "lines": [
      {
       "id": "L1-5-01",
       "speaker": "teacher",
       "en": "Good afternoon!",
       "zh": "下午好！",
       "audio": "L1-5-01.mp3",
       "code": "afternoon",
       "codeIcon": "school"
      },
      {
       "id": "L1-5-02",
       "speaker": "dad",
       "en": "Let's go home.",
       "zh": "我们回家吧。",
       "audio": "L1-5-02.mp3",
       "image": "L1-5-02.jpg"
      },
      {
       "id": "L1-5-03",
       "speaker": "tom",
       "en": "I have to go.",
       "zh": "我得走啦。",
       "audio": "L1-5-03.mp3",
       "icon": "go"
      },
      {
       "id": "L1-5-04",
       "speaker": "tom",
       "en": "Goodbye, Amy!",
       "zh": "再见，艾米！",
       "audio": "L1-5-04.mp3",
       "image": "L1-5-04.jpg"
      },
      {
       "id": "L1-5-05",
       "speaker": "amy",
       "en": "Bye-bye!",
       "zh": "拜拜！",
       "audio": "L1-5-05.mp3",
       "image": "L1-5-05.jpg"
      },
      {
       "id": "L1-5-06",
       "speaker": "tom",
       "en": "See you tomorrow!",
       "zh": "明天见！",
       "audio": "L1-5-06.mp3",
       "code": "tomorrow",
       "codeIcon": "school"
      },
      {
       "id": "L1-5-07",
       "speaker": "amy",
       "en": "See you later!",
       "zh": "待会儿见！",
       "audio": "L1-5-07.mp3",
       "image": "L1-5-07.jpg"
      }
     ]
    },
    {
     "id": "L1-6",
     "titleZh": "晚上好·晚安",
     "titleEn": "Good Night!",
     "lines": [
      {
       "id": "L1-6-01",
       "speaker": "tom",
       "en": "Good evening, Dad!",
       "zh": "晚上好，爸爸！",
       "audio": "L1-6-01.mp3",
       "code": "evening",
       "codeIcon": "house"
      },
      {
       "id": "L1-6-02",
       "speaker": "dad",
       "en": "It's bedtime.",
       "zh": "该睡觉啦。",
       "audio": "L1-6-02.mp3",
       "code": "night",
       "codeIcon": "bed"
      },
      {
       "id": "L1-6-03",
       "speaker": "tom",
       "en": "I'm sleepy.",
       "zh": "我困了。",
       "audio": "L1-6-03.mp3",
       "icon": "sleepy"
      },
      {
       "id": "L1-6-04",
       "speaker": "tom",
       "en": "A story, please!",
       "zh": "请给我讲个故事！",
       "audio": "L1-6-04.mp3",
       "image": "L1-6-04.jpg"
      },
      {
       "id": "L1-6-05",
       "speaker": "tom",
       "en": "Good night, Mom.",
       "zh": "晚安，妈妈。",
       "audio": "L1-6-05.mp3",
       "icon": "sleep"
      },
      {
       "id": "L1-6-06",
       "speaker": "dad",
       "en": "I love you.",
       "zh": "我爱你。",
       "audio": "L1-6-06.mp3",
       "icon": "kiss"
      },
      {
       "id": "L1-6-07",
       "speaker": "tom",
       "en": "I love you, too.",
       "zh": "我也爱你。",
       "audio": "L1-6-07.mp3",
       "image": "L1-6-07.jpg"
      }
     ]
    }
   ]
