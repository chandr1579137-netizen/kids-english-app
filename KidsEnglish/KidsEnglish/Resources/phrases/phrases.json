       "speaker": "tom",
       "en": "I wash my face.",
       "zh": "我洗脸。",
       "audio": "L1-2-04.mp3",
       "image": "L1-2-04.jpg"
      },
      {
       "id": "L1-2-05",
       "speaker": "tom",
       "en": "I brush my teeth.",
       "zh": "我刷牙。",
       "audio": "L1-2-05.mp3",
       "image": "L1-2-05.jpg"
      },
      {
       "id": "L1-2-06",
       "speaker": "tom",
       "en": "I'm ready!",
       "zh": "我准备好啦！",
       "audio": "L1-2-06.mp3",
       "icon": "ready"
      }
     ]
    },
    {
     "id": "L1-3",
     "titleZh": "请和谢谢",
     "titleEn": "Please and Thank You",
     "lines": [
      {
       "id": "L1-3-01",
       "speaker": "tom",
       "en": "Juice, please!",
       "zh": "请给我果汁！",
       "audio": "L1-3-01.mp3",
       "image": "L1-3-01.jpg"
