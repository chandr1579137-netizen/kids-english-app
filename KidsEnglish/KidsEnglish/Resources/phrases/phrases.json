       "speaker": "mom",
       "en": "Here you are.",
       "zh": "给你。",
       "audio": "L1-3-02.mp3",
       "icon": "give"
      },
      {
       "id": "L1-3-03",
       "speaker": "tom",
       "en": "Thank you!",
       "zh": "谢谢！",
       "audio": "L1-3-03.mp3",
       "image": "L1-3-03.jpg"
      },
      {
       "id": "L1-3-04",
       "speaker": "mom",
       "en": "You're welcome.",
       "zh": "不客气。",
       "audio": "L1-3-04.mp3",
       "image": "L1-3-04.jpg"
      },
      {
       "id": "L1-3-05",
       "speaker": "tom",
       "en": "Sorry!",
       "zh": "对不起！",
       "audio": "L1-3-05.mp3",
       "image": "L1-3-05.jpg"
      },
      {
       "id": "L1-3-06",
       "speaker": "amy",
       "en": "It's OK.",
       "zh": "没关系。",
       "audio": "L1-3-06.mp3",
       "image": "L1-3-06.jpg"
      }
     ]
    },
    {
