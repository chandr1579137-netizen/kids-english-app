      {
       "id": "L1-1-04",
       "speaker": "amy",
       "en": "Fine, thanks. And you?",
       "zh": "很好，谢谢。你呢？",
       "audio": "L1-1-04.mp3",
       "image": "L1-1-04.jpg"
