      {
       "id": "L1-1-05",
       "speaker": "tom",
       "en": "I'm fine, too.",
       "zh": "我也很好。",
       "audio": "L1-1-05.mp3",
       "image": "L1-1-05.jpg"
      }
     ]
    },
    {
