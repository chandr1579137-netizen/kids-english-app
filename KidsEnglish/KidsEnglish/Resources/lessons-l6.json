.","blank":"grown","options":[{"text":"grown","value":"grown"},{"text":"grew","value":"grew"},{"text":"growing","value":"growing"}],"correctAnswer":"grown"},{"id":"q2","type":"image_choice","question":"What did grandmother say is precious?","options":[{"text":"Technology","value":"technology","image":"🤖"},{"text":"Nature","value":"nature","image":"🌳"},{"text":"Robots","value":"robots","image":"🦾"}],"correctAnswer":"nature"}],"rewards":{"magicPower":45,"cards":["future","technology","nature"]},"metadata":{"wordCount":95,"estimatedTime":6,"difficulty":6.3}},{"id":"l6_008","level":6,"regionId":"region_l6","title":"The Time Messenger","titleCn":"时空信使","coverImage":"/assets/stories/l6/008.webp","audioFile":"/assets/audio/l6/008.mp3","content":[{"paragraphId":"p1","text":"Alex had received a mysterious letter from his future self. The letter warned him about a decision he would make next week.","translation":"亚历克斯收到了一封来自未来自己的神秘信件。信里提醒他，下周要做的某个决定有危险。","audioStart":0,"audioEnd":8280,"words":[{"word":"Alex","start":100,"end":550,"index":0},{"word":"had","start":562,"end":687,"index":1},{"word":"received","start":700,"end":1150,"index":2},{"word":"a","start":1162,"end":1200,"index":3},{"word":"mysterious","start":1212,"end":1837,"index":4},{"word":"letter","start":1850,"end":2200,"index":5},{"word":"from","start":2212,"end":2375,"index":6},{"word":"his","start":2387,"end":2550,"index":7},{"word":"future","start":2562,"end":2937,"index":8},{"word":"self","start":2950,"end":3425,"index":9},{"word":"The","start":4287,"end":4462,"index":10},{"word":"letter","start":4475,"end":4787,"index":11},{"word":"warned","start":4800,"end":5075,"index":12},{"word":"him","start":5087,"end":5225,"index":13},{"word":"about","start":5237,"end":5500,"index":14},{"word":"a","start":5512,"end":5562,"index":15},{"word":"decision","start":5575,"end":6100,"index":16},{"word":"he","start":6112,"end":6250,"index":17},{"word":"would","start":6262,"end":6400,"index":18},{"word":"make","start":6412,"end":6